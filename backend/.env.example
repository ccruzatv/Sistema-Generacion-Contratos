# Ambiente activo: desa | test | local
# "local" usa SQLite en archivo, sin credenciales ni red PJUD (pruebas localhost).
# Si no existe backend/.env o no se define DB_ENV, el sistema usa "local" por defecto.
DB_ENV=local

# ── LOCAL (SQLite, abierto, sin credenciales) ─────────────────────────────────
# Ruta del archivo SQLite. Por defecto: backend/local.db
# LOCAL_DB_PATH=./local.db

# ── DESA ──────────────────────────────────────────────────────────────────────
ORACLE_DESA_HOST=unexdesa.bdd.pjud
ORACLE_DESA_PORT=1603
ORACLE_DESA_SERVICE=UNEXDESA
ORACLE_DESA_USER=SISTMC
ORACLE_DESA_PASS=

# ── TEST ──────────────────────────────────────────────────────────────────────
ORACLE_TEST_HOST=unextest.bdd.pjud
ORACLE_TEST_PORT=1615
ORACLE_TEST_SERVICE=UNEXTEST
ORACLE_TEST_USER=SISTMC
ORACLE_TEST_PASS=
